[Unit]
After=transmission-vpn-gluetun.service
PartOf=transmission-vpn-gluetun.service

[Container]
AutoUpdate=registry
ContainerName=transmission-vpn-transmission
Environment=PUID={{ podman_uid }} PGID={{ nasusers_gid }} UMASK=006 TZ=America/Los_Angeles
GroupAdd=keep-groups
Image=lscr.io/linuxserver/transmission:latest
Network=container:transmission-vpn-gluetun
UIDMap=+{{ podman_uid }}:0
GIDMap=+{{ nasusers_gid }}:0
Volume=transmission_config:/config:Z
Volume=/mnt/scratch/transmission/downloads:/downloads
Volume=/mnt/scratch/transmission/watch:/watch

[Install]
WantedBy=default.target
